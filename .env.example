# Copy to .env and adjust. .env is git-ignored.

# --- Local (non-Docker) run: point at your own PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://geospatial:CHANGE_ME@localhost:5432/geospatial

# --- Docker Compose (used to build the API's DATABASE_URL and initialise Postgres) ---
POSTGRES_DB=geospatial
POSTGRES_USER=geospatial
POSTGRES_PASSWORD=CHANGE_ME   # avoid characters that need URL-encoding (@ : / %)

# --- Application ---
LOG_LEVEL=INFO
LOG_JSON=true
MAX_UPLOAD_SIZE_BYTES=26214400          # 25 MiB
MAX_UNCOMPRESSED_SIZE_BYTES=209715200   # 200 MiB (ZIP bomb guard)
MAX_ZIP_ENTRIES=200
MAX_COMPRESSION_RATIO=200
SUPPORT_MULTI_GEOMETRIES=true
